<template>
  <div class="page">
    <div class="topbar">
      <text class="brand">VOXEL WORLD</text>
      <text class="coords">12, 64, -8</text>
    </div>

    <div class="scene">
      <div class="sun"></div>
      <div class="cloud cloud-a"></div>
      <div class="cloud cloud-b"></div>

      <div class="far-hill"></div>
      <div class="far-tree far-tree-a"><div class="trunk"></div><div class="leaves"></div></div>
      <div class="far-tree far-tree-b"><div class="trunk"></div><div class="leaves"></div></div>

      <div class="hill"></div>
      <div class="tree tree-a"><div class="trunk"></div><div class="leaves"></div></div>
      <div class="tree tree-b"><div class="trunk"></div><div class="leaves"></div></div>

      <div class="ground">
        <div class="grass grass-a"></div>
        <div class="grass grass-b"></div>
        <div class="stone stone-a"></div>
        <div class="stone stone-b"></div>
      </div>
      <div class="crosshair"></div>
    </div>

    <div class="status">
      <text class="hearts">♥ ♥ ♥</text>
      <text class="label">{{ message }}</text>
    </div>

    <div class="hotbar">
      <div class="slot {{ selectedSlot === 0 ? 'selected' : '' }}" onclick="selectSlot0"><text>⛏</text></div>
      <div class="slot {{ selectedSlot === 1 ? 'selected' : '' }}" onclick="selectSlot1"><text>▦</text></div>
      <div class="slot {{ selectedSlot === 2 ? 'selected' : '' }}" onclick="selectSlot2"><text>▧</text></div>
      <div class="slot {{ selectedSlot === 3 ? 'selected' : '' }}" onclick="selectSlot3"><text>◈</text></div>
    </div>

    <div class="controls">
      <div class="control" onclick="moveLeft">‹</div>
      <div class="control" onclick="mine">⛏</div>
      <div class="control" onclick="moveRight">›</div>
    </div>
  </div>
</template>

<script>
export default {
  private: {
    message: "Tap ⛏ to mine",
    blocks: 0,
    playerStep: 0,
    selectedSlot: 0
  },
  moveLeft() {
    this.playerStep = this.playerStep - 1;
    this.message = "Step: " + this.playerStep;
  },
  moveRight() {
    this.playerStep = this.playerStep + 1;
    this.message = "Step: " + this.playerStep;
  },
  selectSlot0() {
    this.selectedSlot = 0;
    this.message = "Selected: Pickaxe";
  },
  selectSlot1() {
    this.selectedSlot = 1;
    this.message = "Selected: Wood";
  },
  selectSlot2() {
    this.selectedSlot = 2;
    this.message = "Selected: Dirt";
  },
  selectSlot3() {
    this.selectedSlot = 3;
    this.message = "Selected: Stone";
  },
  mine() {
    this.blocks = this.blocks + 1;
    this.message = "Blocks mined: " + this.blocks;
  }
}
</script>

